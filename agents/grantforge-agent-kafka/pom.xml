<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>grantforge</artifactId>
        <groupId>org.devlive.grantforge</groupId>
        <version>2026.3.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>grantforge-agent-kafka</artifactId>
    <name>GrantForge Kafka Agent</name>
    <description>
        Enforces GrantForge policies inside Kafka 3.7 and later brokers and controllers: an authorizer of Kafka's Authorizer API that
        checks every request against the service's signed policy snapshot, answers whether a user may act on any resource of a type,
        shows the policies as read-only ACLs and folds repeated accesses into one audit event. One Java 8 jar with the agent core
        inside it, for Kafka's libs directory.
    </description>

    <properties>
        <maven.compiler.release>8</maven.compiler.release>
        <maven.compiler.testRelease>17</maven.compiler.testRelease>
        <argLine />
        <!--
          The last Java 8 line, free of the client flaws of earlier ones. Kafka 3.7, the oldest line the agent supports, has
          the same Authorizer API, as do the 4.x lines; the integration tests run the jar in each.
        -->
        <kafka.agent.version>3.9.2</kafka.agent.version>
        <!-- The last line for Java 8; Kafka 3.7 ships it too, while 4.x ships 3.x with the same API. Relocated in the jar. -->
        <kafka.agent.caffeine.version>2.9.3</kafka.agent.caffeine.version>
        <grantforge.kafka.it.skip>${skipITs}</grantforge.kafka.it.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${kafka.agent.caffeine.version}</version>
            <exclusions>
                <!-- Annotations for compile-time checkers; nothing reads them at run time. -->
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- The broker provides Kafka and SLF4J; the agent only compiles against Kafka's Authorizer API. -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.agent.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <!-- A repeated package must recreate the input jar rather than shading the prior shaded output. -->
                <configuration>
                    <forceCreation>true</forceCreation>
                </configuration>
            </plugin>
            <!-- Verify the shaded JAR after package, inside real Kafka releases. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${plugin.surefire.version}</version>
                <configuration>
                    <skipITs>${grantforge.kafka.it.skip}</skipITs>
                    <reuseForks>false</reuseForks>
                    <systemPropertyVariables>
                        <grantforge.kafka.agent.jar>${project.build.directory}/${project.build.finalName}.jar</grantforge.kafka.agent.jar>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>com.fasterxml.jackson</pattern>
                                    <shadedPattern>org.devlive.grantforge.kafka.agent.internal.jackson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.bouncycastle</pattern>
                                    <shadedPattern>org.devlive.grantforge.kafka.agent.internal.bouncycastle</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.github.benmanes.caffeine</pattern>
                                    <shadedPattern>org.devlive.grantforge.kafka.agent.internal.caffeine</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
