<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>grantforge</artifactId>
        <groupId>org.devlive.grantforge</groupId>
        <version>2026.3.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>grantforge-agent-yarn</artifactId>
    <name>GrantForge YARN Agent</name>
    <description>
        Enforces GrantForge policies in Hadoop 3.2 and later ResourceManagers: an authorization provider that decides who may
        submit applications to a queue, and which applications, at every queue of its path, who may administer a queue and
        the cluster, against the service's signed policy snapshot, with policy items that hold for some client addresses only,
        and folds repeated accesses into one audit event. One Java 8 jar with the agent core inside it, for YARN's lib
        directory.
    </description>

    <properties>
        <maven.compiler.release>8</maven.compiler.release>
        <maven.compiler.testRelease>17</maven.compiler.testRelease>
        <argLine />
        <!-- The oldest line the agent supports; Hadoop 3.3, 3.4 and 3.5 keep its authorization provider API. -->
        <yarn.agent.hadoop.version>3.2.4</yarn.agent.hadoop.version>
        <yarn.agent.caffeine.version>2.9.3</yarn.agent.caffeine.version>
        <grantforge.yarn.it.skip>${skipITs}</grantforge.yarn.it.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${yarn.agent.caffeine.version}</version>
            <exclusions>
                <!-- Annotations for compile-time checkers; nothing reads them at run time. -->
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
          Hadoop's shaded client, ahead of the ResourceManager's own classes below, so that the tests run Hadoop's classes
          with all they need inside them; none of it is in the agent jar, and the agent compiles against Hadoop 3.2.4.
        -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client-runtime</artifactId>
            <version>${hdfs.client.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client-api</artifactId>
            <version>${hdfs.client.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The ResourceManager provides Hadoop and SLF4J; the agent compiles against YARN's authorization provider API. -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-yarn-common</artifactId>
            <version>${yarn.agent.hadoop.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-yarn-api</artifactId>
            <version>${yarn.agent.hadoop.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-common</artifactId>
            <version>${yarn.agent.hadoop.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <!-- A repeated package must recreate the input jar rather than shading the prior shaded output. -->
                <configuration>
                    <forceCreation>true</forceCreation>
                </configuration>
            </plugin>
            <!-- Verify the shaded JAR after package, inside real ResourceManagers. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${plugin.surefire.version}</version>
                <configuration>
                    <skipITs>${grantforge.yarn.it.skip}</skipITs>
                    <reuseForks>false</reuseForks>
                    <systemPropertyVariables>
                        <grantforge.yarn.agent.jar>${project.build.directory}/${project.build.finalName}.jar</grantforge.yarn.agent.jar>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>com.fasterxml.jackson</pattern>
                                    <shadedPattern>org.devlive.grantforge.yarn.agent.internal.jackson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.bouncycastle</pattern>
                                    <shadedPattern>org.devlive.grantforge.yarn.agent.internal.bouncycastle</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.github.benmanes.caffeine</pattern>
                                    <shadedPattern>org.devlive.grantforge.yarn.agent.internal.caffeine</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
