dist/
!script/bin/
.claude/
/.Codex/

core/grantforge-web/test-results/
core/grantforge-web/playwright-report/
core/grantforge-web/coverage/

# Python bytecode
__pycache__/
*.py[cod]

# Default embedded database of local and distribution runs
/data/
core/grantforge-server/data/

# Local Vitest reporter output
core/grantforge-web/.vitest/

# jqwik keeps failing samples locally to replay them first
.jqwik-database
