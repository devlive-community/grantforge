<!-- The data source service is a Spring-managed dependency, not mutable data owned by the controller. -->
<FindBugsFilter>
    <Match>
        <Class name="org.devlive.grantforge.server.datasource.DataSourceController"/>
        <Field name="sources"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
