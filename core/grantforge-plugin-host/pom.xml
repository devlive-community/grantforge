<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>grantforge</artifactId>
        <groupId>org.devlive.grantforge</groupId>
        <version>2026.3.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>grantforge-plugin-host</artifactId>
    <name>GrantForge Plugin Host</name>
    <description>Loads service type plugins: built-in ones from the classpath, external ones from the plugins directory, each in its own class loader</description>

    <dependencies>
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-plugin-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-audit</artifactId>
        </dependency>
        <!-- Plugin descriptors are YAML. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Tests build the schema from the production changelog, so entities and migrations cannot drift. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Only to build the example plugin first: ExamplePluginTest installs its output as an external plugin. -->
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-plugin-example</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Likewise for the HDFS plugin: HdfsPluginTest installs it with its Jackson, as the release ships it. -->
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-plugin-hdfs</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- And for the ZooKeeper plugin: ZooKeeperPluginTest installs it, with ZooKeeper's client in the plugin's own
             class loader, and talks to a ZooKeeper server started from these test dependencies. -->
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-plugin-zookeeper</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.zookeeper</groupId>
            <artifactId>zookeeper</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- And for the Hive plugin: HivePluginTest installs it with Hive's JDBC driver in its own class loader. -->
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-plugin-hive</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- And for the Kafka plugin: KafkaPluginTest installs it with Kafka's clients in its own class loader. -->
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-plugin-kafka</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- And for the HBase plugin: HBasePluginTest installs it with HBase's and Hadoop's clients in its own class loader. -->
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-plugin-hbase</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- And for the Trino plugin: TrinoPluginTest installs it with Trino's JDBC driver in its own class loader. -->
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-plugin-trino</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- And for the YARN plugin: YarnPluginTest installs it with Hadoop's YARN client in its own class loader. -->
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-plugin-yarn</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- And for the Pulsar plugin: PulsarPluginTest installs it with Pulsar's admin client in its own class loader, from
             the plugin's own directory, so the client stays off this module's class path. -->
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-plugin-pulsar</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- And for the MySQL plugin: MySqlPluginTest installs it with MariaDB Connector/J in its own class loader. -->
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-plugin-mysql</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.dropwizard.metrics</groupId>
            <artifactId>metrics-core</artifactId>
            <version>4.2.40</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial.snappy</groupId>
            <artifactId>snappy-java</artifactId>
            <version>1.1.10.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-test-support</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
