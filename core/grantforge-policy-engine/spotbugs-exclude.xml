<!--
  The engine targets Java 8, which has no List.copyOf and friends. Its model classes copy what they are given into
  Collections.unmodifiable* views, which SpotBugs cannot tell from mutable collections, so it reports their getters.
-->
<FindBugsFilter>
    <Match>
        <Package name="org.devlive.grantforge.policy.engine"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
