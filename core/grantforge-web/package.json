{
  "name": "grantforge",
  "version": "2026.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@8.10.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript src/api/openapi.json --output src/api/schema.d.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@lucide/vue": "1.73.0",
    "pinia": "4.1.0",
    "uqr": "0.1.3",
    "vue": "3.5.45",
    "vue-i18n": "11.4.20",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^29.0.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": "1.2.2",
      "glob@^13": "14.0.2",
      "minimatch@^10": "11.0.3"
    }
  }
}
