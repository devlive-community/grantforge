{
  "components" : {
    "schemas" : {
      "BootstrapResponse" : {
        "properties" : {
          "registrationEnabled" : {
            "type" : "boolean"
          },
          "setupRequired" : {
            "type" : "boolean"
          }
        },
        "required" : [ "registrationEnabled", "setupRequired" ],
        "type" : "object"
      },
      "SetupRequest" : {
        "properties" : {
          "displayName" : {
            "maxLength" : 128,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 1024,
            "minLength" : 0,
            "type" : "string"
          },
          "tenantName" : {
            "maxLength" : 128,
            "minLength" : 0,
            "type" : "string"
          },
          "token" : {
            "maxLength" : 256,
            "minLength" : 0,
            "type" : "string"
          },
          "username" : {
            "minLength" : 1,
            "pattern" : "\\s*[A-Za-z0-9._@-]{3,64}\\s*",
            "type" : "string"
          }
        },
        "required" : [ "password", "token", "username" ],
        "type" : "object"
      },
      "SetupResponse" : {
        "properties" : {
          "tenantCode" : {
            "type" : "string"
          },
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "tenantCode", "username" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Fine-grained, plugin-based authorization platform",
    "license" : {
      "name" : "MIT",
      "url" : "https://opensource.org/license/mit"
    },
    "title" : "GrantForge API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/bootstrap" : {
      "get" : {
        "operationId" : "bootstrap",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BootstrapResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "setup-controller" ]
      }
    },
    "/api/v1/setup" : {
      "post" : {
        "operationId" : "completeSetup",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SetupRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SetupResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "setup-controller" ]
      }
    }
  },
  "servers" : [ {
    "url" : "/"
  } ]
}
