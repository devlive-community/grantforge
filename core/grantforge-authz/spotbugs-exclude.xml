<!-- Spring injects the repository proxy; it is not mutable state owned by the services. -->
<FindBugsFilter>
    <Match>
        <Class name="org.devlive.grantforge.authz.application.UserResourceGrantService"/>
        <Field name="grants"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="org.devlive.grantforge.authz.application.DirectGrantCleanup"/>
        <Field name="grants"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
