<!-- The repository is an injected persistence service, not mutable data owned by DirectoryWriter. -->
<FindBugsFilter>
    <Match>
        <Class name="org.devlive.grantforge.datasource.application.DirectoryWriter"/>
        <Field name="members"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
