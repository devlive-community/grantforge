<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>grantforge-samples</artifactId>
        <groupId>org.devlive.grantforge</groupId>
        <version>2026.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>grantforge-sample-notes</artifactId>
    <name>GrantForge Sample Notes</name>
    <description>
        A server-side notes application that signs users in through GrantForge with Spring Security's OAuth 2.0 login (a
        confidential client) and hands their access token to the Spring Boot starter to check permissions.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.devlive.grantforge</groupId>
            <artifactId>grantforge-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
