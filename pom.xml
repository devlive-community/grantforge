    <name>GrantForge</name>
    <description>Open-source, plugin-based fine-grained authorization platform</description>
    <url>https://github.com/devlive-community/grantforge</url>

    <!-- Modules are added by the task that first needs them (see the rebuild plan). -->
    <modules>
        <module>core/grantforge-test-support</module>
        <module>core/grantforge-common</module>
        <module>core/grantforge-persistence</module>
        <module>core/grantforge-plugin-api</module>
        <module>core/grantforge-policy-engine</module>
        <module>core/grantforge-agent-core</module>
        <module>core/grantforge-audit</module>
        <module>core/grantforge-identity</module>
        <module>core/grantforge-authz</module>
        <module>core/grantforge-plugin-host</module>
        <module>core/grantforge-service</module>
        <module>core/grantforge-oauth</module>
        <module>core/grantforge-server</module>

        <!-- Service type plugins loaded by the GrantForge server. -->
        <module>plugins/grantforge-plugin-hdfs</module>
        <module>plugins/grantforge-plugin-example</module>

        <!-- Agents embedded in protected systems such as HDFS NameNodes. -->
        <module>agents/grantforge-agent-hdfs-common</module>
        <module>agents/grantforge-agent-hdfs-native</module>
        <module>agents/grantforge-agent-hdfs-2.7</module>
        <module>agents/grantforge-agent-hdfs-2.10</module>
        <module>agents/grantforge-agent-hdfs-3.2</module>
