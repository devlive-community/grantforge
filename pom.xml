        <module>agents/grantforge-agent-hdfs-3.4</module>
        <module>agents/grantforge-agent-hdfs-3.5</module>

        <module>sdk/grantforge-spring-boot-starter</module>
    </modules>

    <scm>
        <url>https://github.com/devlive-community/grantforge</url>
        <connection>scm:git:https://github.com/devlive-community/grantforge.git</connection>
        <developerConnection>scm:git:git@github.com:devlive-community/grantforge.git</developerConnection>
    </scm>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>qianmoQ</name>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>

    <properties>
        <!-- Skips the HDFS modules' Testcontainers ITs (script/ci/db_integration.sh); nightly runs them. It follows
             -DskipITs, which the modules' own skipITs setting would otherwise hide. -->
        <skipITs>false</skipITs>
        <grantforge.hdfs.it.skip>${skipITs}</grantforge.hdfs.it.skip>
        <!-- Minimum supported runtime. Class files are verified by script/ci/check_java_bytecode.py. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>4.1.1</spring-boot.version>
        <jspecify.version>1.0.1</jspecify.version>
        <errorprone.version>2.50.0</errorprone.version>
        <nullaway.version>0.14.2</nullaway.version>
        <archunit.version>1.5.1</archunit.version>
        <!-- Property-based tests of the authorization rules (JUnit Platform engine). -->
        <jqwik.version>1.9.3</jqwik.version>
        <jmh.version>1.37</jmh.version>
        <springdoc.version>3.1.1</springdoc.version>
        <bouncycastle.version>1.86</bouncycastle.version>
        <!-- The HDFS plugin talks to clusters with Hadoop's own client, shaded so its dependencies stay inside it. -->
        <hdfs.client.version>3.5.0</hdfs.client.version>
        <!-- A Kerberos KDC for the HDFS plugin's tests; what Hadoop's own MiniKdc runs on. -->
        <kerby.version>2.1.2</kerby.version>
        <!-- Database for the *IT tests (profile database-it): h2, or <engine>:<version> such as postgres:17. -->
        <grantforge.it.database>h2</grantforge.it.database>
        <!--
          Security patches newer than the versions managed by Spring Boot 4.1.1:
          Tomcat 11.0.25 fixes GHSA-9xv2-5v5q-p794 / GHSA-gcx9-497g-6cp6 / GHSA-h3x4-894j-xpx5,
          jackson-databind 3.1.6 fixes GHSA-gx83-3vf8-gh7j / GHSA-q4xh-88c3-wmh7 / GHSA-wjgm-6hv5-3cvf,
          jackson-databind 2.21.7 (Jackson 2, used by swagger-core) also fixes GHSA-cxp5-3px4-pw24 / GHSA-wv8q-qhhj-9h54.
          Remove each override once the managed Spring Boot version includes the fix.
        -->
        <tomcat.patch.version>11.0.26</tomcat.patch.version>
        <jackson.patch.version>3.1.7</jackson.patch.version>
        <jackson2.patch.version>2.21.7</jackson2.patch.version>
        <!--
          Liquibase 5.x is licensed under FSL-1.1 (not OSI open source); 4.33.0 is the last Apache-2.0
          release. Pinned by decision; the weekly OSV scan reports any advisory against it.
        -->
        <liquibase.pin.version>4.33.0</liquibase.pin.version>

        <plugin.compiler.version>3.16.0</plugin.compiler.version>
        <plugin.surefire.version>3.6.0</plugin.surefire.version>
        <plugin.enforcer.version>3.6.3</plugin.enforcer.version>
        <plugin.checkstyle.version>3.6.0</plugin.checkstyle.version>
        <plugin.spotbugs.version>4.10.4.1</plugin.spotbugs.version>
        <plugin.exec.version>3.6.4</plugin.exec.version>
        <plugin.assembly.version>3.8.0</plugin.assembly.version>
        <plugin.dependency.version>3.7.0</plugin.dependency.version>
        <plugin.jacoco.version>0.8.15</plugin.jacoco.version>
        <plugin.cyclonedx.version>2.9.3</plugin.cyclonedx.version>
        <!-- Publishing the Maven artifacts (profiles release and central, .github/workflows/release.yml). -->
        <plugin.source.version>3.3.1</plugin.source.version>
        <plugin.javadoc.version>3.12.0</plugin.javadoc.version>
        <plugin.gpg.version>3.2.8</plugin.gpg.version>
        <plugin.central.version>0.11.0</plugin.central.version>
        <!-- The central profile publishes only when told to (-Dcentral.skip=false, the release workflow): with server
             credentials in ~/.m2/settings.xml, a local build with the profile would otherwise upload to Maven Central. -->
        <central.skip>true</central.skip>
        <!-- The server's release bundles the plugins and agents; builds of a few modules (the database tests) skip it. -->
        <grantforge.bundle.skip>false</grantforge.bundle.skip>
        <!-- The vulnerability scan covers test dependencies too; a release's SBOM lists only what it ships (-Dsbom.includeTestScope=false). -->
        <sbom.includeTestScope>true</sbom.includeTestScope>
        <plugin.pmd.version>3.28.0</plugin.pmd.version>
    </properties>

