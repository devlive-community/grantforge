{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact Maven compatibility dependency exceptions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exceptions"],
  "properties": {
    "schema_version": {"const": 1},
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "purl", "version", "vulnerability", "projects", "reason", "expires", "references"],
        "properties": {
          "source": {"const": "target/bom.json"},
          "purl": {"type": "string", "pattern": "^pkg:maven/[^/@*?]+/[^/@*?]+@[^@*?]+(?:\\?[^*]+)?$"},
          "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"},
          "vulnerability": {"type": "string", "pattern": "^GHSA-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}$"},
          "projects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "scopes"],
              "properties": {
                "path": {"type": "string", "pattern": "^(?:[A-Za-z0-9_.-]+/)*pom\\.xml$"},
                "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["provided", "test"]}}
              }
            }
          },
          "reason": {"type": "string", "minLength": 1},
          "expires": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "references": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://[^/]+(?:/.*)?$"}}
        }
      }
    }
  }
}
