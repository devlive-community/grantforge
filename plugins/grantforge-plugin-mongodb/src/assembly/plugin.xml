<!-- The plugin as the plugin host reads a directory or zip: the descriptor at the top, classes/ and lib/*.jar. -->
<assembly>
    <id>plugin</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <dependencySets>
        <dependencySet>
            <useProjectArtifact>false</useProjectArtifact>
            <outputDirectory>lib</outputDirectory>
            <scope>runtime</scope>
        </dependencySet>
    </dependencySets>
    <fileSets>
        <fileSet>
            <directory>${project.build.outputDirectory}</directory>
            <outputDirectory>classes</outputDirectory>
            <excludes>
                <exclude>grantforge-plugin.yaml</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>${project.build.outputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>grantforge-plugin.yaml</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
